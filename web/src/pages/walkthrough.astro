---
// walkthrough.astro — the monotonic-enhancement continuum, rendered by the REAL library.
//
// Every panel below is genuine painted output: tools/outputgen.py captured the
// demos/patterns/monitor.py render at each point on the continuum and wrote it
// through render_html (cells → HTML). Only the LAST stage (interactive) is the
// cosmetic PaintedSurface island — the one legitimately-not-real stop, because
// a live alt-screen TUI can't be a static fragment.
//
// The fragments are committed artifacts under src/generated/panels/, produced
// on `main` by `outputgen --emit-panels`. The site is a pure consumer.
import Base from "../layouts/Base.astro";
import PaintedSurface from "../components/PaintedSurface.jsx";

import monitorQ from "../generated/panels/monitor_q.html?raw";
import monitorTranscribe from "../generated/panels/monitor_transcribe.html?raw";
import monitorDefault from "../generated/panels/monitor_default.html?raw";
import monitorHonest from "../generated/panels/monitor_default_honest.html?raw";
import monitorVv from "../generated/panels/monitor_vv.html?raw";
import monitorLive from "../generated/panels/monitor_live.html?raw";
import monitorPlain from "../generated/panels/monitor_plain.html?raw";
import monitorJson from "../generated/panels/monitor_json.html?raw";

const STOPS = [
  { id: "paint", n: "01", label: "transcribe", entry: "paint(vitals)" },
  { id: "lens", n: "02", label: "+ lens", entry: "lens=vitals_lens" },
  { id: "tool", n: "03", label: "+ argv", entry: "run_cli" },
  { id: "live", n: "04", label: "+ time", entry: "--live" },
  { id: "tui", n: "05", label: "+ events", entry: "-i  ·  Surface" },
];
---

<Base title="painted — monotonic enhancement">
  <div class="wt-root">
    <header class="wt-hero">
      <div class="wt-bigword">monotonic</div>
      <p class="wt-intro">
        One library. Print to TUI. One dataset — a host's vitals — enters as
        <code>paint(vitals)</code> and walks all the way to a full-screen app.
        Watch what survives each step: not the call — the <strong>lens</strong>,
        the one <code>data&nbsp;→&nbsp;Block</code> function every stop below
        renders through. Here is the whole continuum, <strong>rendered by
        painted itself</strong> — every panel is real <code>render_html</code>
        output, not a mock.
      </p>
    </header>

    <div class="wt-page">
      <nav class="wt-spine" aria-label="continuum">
        <div class="wt-spine-inner">
          <div class="wt-spine-eyebrow">ONE LENS →</div>
          <ol class="wt-stops">
            {STOPS.map((s) => (
              <li><a href={`#${s.id}`} data-stop={s.id}>
                <span class="wt-dot"></span>
                <span class="wt-stop-text">
                  <span class="wt-stop-label">{s.label}</span>
                  <span class="wt-stop-entry">{s.entry}</span>
                </span>
              </a></li>
            ))}
          </ol>
          <div class="wt-spine-foot">
            <div class="wt-foot-title">monotonic enhancement</div>
            <div class="wt-foot-sub">same data, same render fn — only the surface escalates.</div>
          </div>
        </div>
      </nav>

      <main class="wt-main">
        <!-- 01 — transcribe -->
        <section id="paint" data-stage="paint" class="wt-stage">
          <div class="wt-stage-head"><span class="wt-n">01</span><span class="wt-label">transcribe</span><span class="wt-entry">paint(vitals) → key/value</span></div>
          <h2 class="wt-title">Drop it in. It transcribes your data — styled, TTY-aware.</h2>
          <div class="shell">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">tty · truecolor</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>python -c 'from painted import paint; paint(vitals)'</div>
              <div class="panel" set:html={monitorTranscribe} />
            </div>
          </div>
          <p class="note">
            Zero config — <code>paint()</code> transcribes what the value
            <em>declares</em>: a dict becomes its key/value pairs, as themselves.
            It never invents a shape the data didn't state — a bare list is
            items, never a chart. This is the floor of the walk, and the one
            stop that needs no lens: you haven't made a claim yet.
          </p>
        </section>

        <!-- 02 — the lens: your first claim -->
        <section id="lens" data-stage="lens" class="wt-stage">
          <div class="wt-stage-head"><span class="wt-n">02</span><span class="wt-label">+ lens</span><span class="wt-entry">paint(vitals, lens=vitals_lens)</span></div>
          <h2 class="wt-title">Make a claim. A lens interprets — and it's the piece that ports.</h2>
          <pre class="code"><span class="code-dim"># the lens: data → Block. Write it once — every stop below renders through it.</span>
def vitals_lens(vitals, zoom, width):
    ...  <span class="code-dim"># severity bars, semantic color, per-metric status</span>

paint(vitals, lens=vitals_lens)</pre>
          <div class="shell" data-alt="false">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">tty · truecolor</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>python monitor.py</div>
              <div class="panel panel-primary" set:html={monitorDefault} />
              <div class="panel panel-alt" set:html={monitorHonest} />
            </div>
          </div>
          <p class="note">
            Severity bars are a <em>claim</em> — "these numbers sit on a scale" —
            so they live in a lens, never in <code>paint()</code>'s default. The
            lens is also where mark and ref attach: color is semantic (mem in the
            red, cpu warned, net cool), vivid truecolor by default.
            <button class="toggle" data-toggle-alt>see the 16-color downsample ▸</button>
            <span class="note-dim">the toggle swaps to the named-color palette a basic terminal would show — one <code>use_palette()</code> call away.</span>
          </p>
        </section>

        <!-- 03 — argv: the call disappears, the lens doesn't -->
        <section id="tool" data-stage="tool" class="wt-stage">
          <div class="wt-stage-head"><span class="wt-n">03</span><span class="wt-label">+ argv</span><span class="wt-entry">run_cli · -q / -vv · | cat · --json</span></div>
          <h2 class="wt-title">Grow into a tool. The paint() call is gone — the lens is unchanged.</h2>
          <pre class="code"><span class="code-dim"># run_cli is paint() wearing argv. Same lens, new trigger.</span>
def renderer(data, fidelity, width):
    return vitals_lens(data, fidelity.depth, width)

run_cli(sys.argv[1:], renderer=renderer, fetch=get_vitals)</pre>
          <div class="shell">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">-q · quiet</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>monitor.py -q</div>
              <div class="panel" set:html={monitorQ} />
            </div>
          </div>
          <div class="shell">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">-vv · verbose</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>monitor.py -vv</div>
              <div class="panel" set:html={monitorVv} />
            </div>
          </div>
          <p class="note">The dials come free: <code>-q</code>/<code>-vv</code> turn the zoom your lens already reads. Depth 0 is worst-first, one line — for a status bar or a cron log; depth 2 is the same numbers plus per-metric status. Escalation is a feature, not a different tool.</p>
          <div class="shell">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">pipe · no tty</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>python monitor.py | cat</div>
              <div class="panel" set:html={monitorPlain} />
            </div>
          </div>
          <div class="shell">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">--json</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>python monitor.py --json</div>
              <div class="panel" set:html={monitorJson} />
            </div>
          </div>
          <p class="note">Format is the harness's job, not the lens's: no ANSI in a pipe — same structure, color stripped — and <code>--json</code> re-derives from the fetched data. That's why <code>paint()</code> itself has no <code>format=</code>.</p>
          <p class="note"><a class="branch" href="/walkthrough/fidelity">go deeper — the disclosure ladder ▸</a> <span class="note-dim">depth is the first rung: named facets, named depth spellings, density budgets, structural disclosure climb from here.</span></p>
        </section>

        <!-- 04 — time -->
        <section id="live" data-stage="live" class="wt-stage">
          <div class="wt-stage-head"><span class="wt-n">04</span><span class="wt-label">+ time</span><span class="wt-entry">--live → diff-flush</span></div>
          <h2 class="wt-title">Same output, rewritten in place on a steady tick.</h2>
          <div class="shell">
            <div class="shell-bar"><span class="shell-title">bash</span><span class="shell-tty">--live · 60s</span></div>
            <div class="shell-body">
              <div class="cmd"><span class="cmd-prompt">~/svc $ </span>python monitor.py --live</div>
              <div class="panel" set:html={monitorLive} />
            </div>
          </div>
          <p class="note">A later tick — cpu and net drifted, mem eased; only the cells that changed are rewritten. The lens fires per tick now instead of once; it still hasn't changed. This is the bridge from a one-shot print to a living surface.</p>
        </section>

        <!-- 05 — events -->
        <section id="tui" data-stage="tui" class="wt-stage">
          <div class="wt-stage-head"><span class="wt-n">05</span><span class="wt-label">+ events</span><span class="wt-entry">-i  ·  Surface + Layer</span></div>
          <h2 class="wt-title">Cross into the alt-screen. The lens ports a third time.</h2>
          <pre class="code"><span class="code-dim"># the same lens, driven by keystrokes instead of argv.</span>
class StatusApp(Surface):
    def render(self):
        return vitals_lens(self.state, self.zoom, self.width)</pre>
          <div class="hero-slot"><PaintedSurface client:visible initialView="Status" /></div>
          <p class="note"><span class="note-dim">cosmetic hero — recreation, not the renderer.</span> The full TUI: keyboard-first, diff-flushed; modal Blocks paint on top while the base dims. (click to focus, then use the keys.)</p>
        </section>

        <footer class="wt-end">
          <h2>You never rewrote the lens.</h2>
          <p>One dataset, one lens, three deliverers — <code>paint()</code> direct, <code>run_cli</code> on argv, <code>Surface</code> on events. The verb recurs at every altitude; you swap the trigger around your render function, never the function itself. That's the continuous surface.</p>
        </footer>
      </main>
    </div>
  </div>
</Base>

<style>
  .wt-root { max-width: 1180px; margin: 0 auto; padding: var(--sp-7) var(--sp-5) var(--sp-8); }
  .wt-hero { max-width: 720px; margin-bottom: var(--sp-7); }
  .wt-bigword { font-size: var(--t-display); font-weight: var(--w-black); color: var(--cyan); line-height: var(--cell-lh-tight); letter-spacing: -0.02em; }
  .wt-intro { font-size: var(--t-h3); color: var(--fg-2); line-height: 1.6; margin-top: var(--sp-4); }
  .wt-intro code { color: var(--cyan); }

  .wt-page { display: grid; grid-template-columns: 200px 1fr; gap: var(--sp-6); align-items: start; }
  @media (max-width: 760px) { .wt-page { grid-template-columns: 1fr; } .wt-spine { display: none; } }

  /* Spine */
  .wt-spine-inner { position: sticky; top: 64px; }
  .wt-spine-eyebrow { font-size: var(--t-caption); letter-spacing: 0.08em; color: var(--fg-dim); }
  .wt-stops { list-style: none; margin: var(--sp-4) 0 0; padding: 0; position: relative; }
  .wt-stops::before { content: ""; position: absolute; left: 6px; top: 6px; bottom: 6px; width: 1px; background: var(--line); }
  .wt-stops li { margin-bottom: var(--sp-4); }
  .wt-stops a { display: flex; gap: var(--sp-3); align-items: flex-start; text-decoration: none; }
  .wt-dot { width: 13px; height: 13px; margin-top: 3px; flex-shrink: 0; background: var(--ink); border: 1px solid var(--line-bold); z-index: 1; }
  .wt-stops a[aria-current="true"] .wt-dot { background: var(--cyan); border-color: var(--cyan); }
  .wt-stop-text { display: flex; flex-direction: column; gap: 1px; }
  .wt-stop-label { font-size: var(--t-small); font-weight: var(--w-bold); color: var(--fg-2); white-space: nowrap; }
  .wt-stops a[aria-current="true"] .wt-stop-label { color: var(--cyan); }
  .wt-stop-entry { font-size: var(--t-caption); color: var(--fg-dim); white-space: nowrap; }
  .wt-spine-foot { margin-top: var(--sp-4); padding-top: var(--sp-3); border-top: 1px solid var(--line); }
  .wt-foot-title { font-size: var(--t-small); font-weight: var(--w-bold); color: var(--cyan); }
  .wt-foot-sub { font-size: var(--t-caption); color: var(--fg-dim); margin-top: 2px; line-height: 1.4; }

  /* Stages */
  .wt-main { min-width: 0; }
  .wt-stage { margin-bottom: var(--sp-8); scroll-margin-top: var(--sp-5); }
  .wt-stage-head { display: flex; gap: var(--sp-2); align-items: baseline; margin-bottom: var(--sp-2); flex-wrap: wrap; }
  .wt-n, .wt-label { font-size: var(--t-caption); letter-spacing: 0.05em; color: var(--cyan); font-weight: var(--w-bold); }
  .wt-label { text-transform: uppercase; }
  .wt-entry { font-size: var(--t-caption); color: var(--fg-dim); margin-left: auto; }
  .wt-title { font-size: var(--t-h2); font-weight: var(--w-bold); color: var(--fg); margin: 0 0 var(--sp-4); letter-spacing: -0.01em; }

  /* Shell window frame */
  .shell { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--ink); margin-bottom: var(--sp-3); }
  .shell-bar { display: flex; justify-content: space-between; align-items: center; padding: var(--sp-1) var(--sp-3); border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 80%, #fff 4%); }
  .shell-title { font-size: var(--t-caption); color: var(--fg-dim); }
  .shell-tty { font-size: var(--t-caption); color: var(--fg-dim); }
  .shell-body { padding: var(--sp-3) var(--sp-4); }
  .cmd { white-space: pre-wrap; margin-bottom: var(--sp-2); font-size: var(--t-cell); }
  .cmd-prompt { color: var(--green); font-weight: var(--w-bold); }

  /* the lens snippet — the porting artifact, shown as code */
  .code { border: 1px solid var(--line); border-radius: 6px; background: var(--ink); padding: var(--sp-3) var(--sp-4); margin: 0 0 var(--sp-3); font-size: var(--t-cell); line-height: 1.6; color: var(--fg-2); overflow-x: auto; }
  .code-dim { color: var(--fg-dim); }

  /* painted-output panels render via the global .painted-output rule (tokens) */
  .panel :global(.painted-output) { margin: 0; background: transparent; }

  /* vivid default ↔ honest "downsample" toggle */
  .panel-alt { display: none; }
  .shell[data-alt="true"] .panel-primary { display: none; }
  .shell[data-alt="true"] .panel-alt { display: block; }
  .toggle { font: inherit; font-size: var(--t-caption); color: var(--cyan); background: none; border: 1px solid var(--line-bold); border-radius: 4px; padding: 2px 8px; cursor: pointer; margin: 0 var(--sp-2); }
  .toggle:hover { border-color: var(--cyan); }

  .note { font-size: var(--t-small); color: var(--fg-2); line-height: 1.6; margin-top: var(--sp-2); }
  .note code { color: var(--cyan); }
  .note-dim { color: var(--fg-dim); }
  .branch { color: var(--cyan); font-weight: var(--w-bold); text-decoration: none; }
  .branch:hover { text-decoration: underline; }

  .hero-slot { height: min(70vh, 600px); display: flex; }

  .wt-end { border-top: 1px solid var(--line); padding-top: var(--sp-4); margin-top: var(--sp-6); }
  .wt-end h2 { font-size: var(--t-h3); font-weight: var(--w-bold); color: var(--fg); margin: 0 0 var(--sp-2); }
  .wt-end p { max-width: 640px; font-size: var(--t-small); color: var(--fg-2); line-height: 1.6; }
</style>

<script is:inline>
  // Spine active-state on scroll.
  const stops = Array.from(document.querySelectorAll("[data-stop]"));
  const stages = Array.from(document.querySelectorAll("[data-stage]"));
  const byId = (id) => stops.find((a) => a.dataset.stop === id);
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        stops.forEach((a) => a.removeAttribute("aria-current"));
        const a = byId(e.target.id);
        if (a) a.setAttribute("aria-current", "true");
      }
    });
  }, { rootMargin: "-45% 0px -45% 0px", threshold: 0 });
  stages.forEach((s) => io.observe(s));

  // Vivid default ↔ honest "downsample" toggle (the use_palette() story, live).
  document.querySelectorAll("[data-toggle-alt]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".wt-stage").querySelector(".shell[data-alt]");
      const on = shell.getAttribute("data-alt") === "true";
      shell.setAttribute("data-alt", on ? "false" : "true");
      btn.textContent = on ? "see the 16-color downsample ▸" : "back to truecolor ▸";
    });
  });
</script>
