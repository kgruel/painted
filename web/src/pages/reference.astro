---
import PageHeader from "../components/PageHeader.astro";
import ReferenceEntry from "../components/reference/ReferenceEntry.astro";
import referenceCoverage from "../generated/reference_coverage.json";
import Prototype from "../layouts/Prototype.astro";
import "../styles/reference.css";

const loadedPanels = import.meta.glob("../generated/panels/*.html", {
  eager: true,
  query: "?raw",
  import: "default",
}) as Record<string, string>;

const specimens = Object.fromEntries(
  referenceCoverage.specimens.map((specimen) => [specimen.id, specimen]),
);
const fragments = Object.fromEntries(
  referenceCoverage.specimens.map((specimen) => {
    const fragment = loadedPanels[`../generated/${specimen.fragment}`];
    if (typeof fragment !== "string") {
      throw new Error(`Missing generated reference fragment: ${specimen.fragment}`);
    }
    return [specimen.id, fragment];
  }),
);
const { summary } = referenceCoverage;
---

<Prototype
  title="Painted capability reference"
  description="A capability-oriented index of Painted specimens, guides, source, and explicit omissions."
  current="reference"
>
  <div class="proto-shell proto-page reference-page">
    <PageHeader
      eyebrow="Reference"
      title="Find the capability, then follow its evidence."
      summary="This bounded index accounts for nine capability families. Published cells appear only where a static specimen is honest; lifecycle and event behavior points to a guide or source."
    >
      <div class="reference-actions">
        <a class="proto-button" href="#capability-index">Browse the index <span aria-hidden="true">↓</span></a>
        <a class="reference-secondary-link" href="/about/rendered-by-painted/">How evidence is published</a>
      </div>
    </PageHeader>

    <aside class="reference-report" aria-labelledby="coverage-heading">
      <div>
        <p class="proto-eyebrow">Generated coverage report</p>
        <h2 id="coverage-heading">{summary.capability_count} declared capabilities across {summary.family_count} families</h2>
        <p>“Accounted for” means each scoped term has an evidence mode. It is not a claim that every exported API has a bespoke reference page.</p>
      </div>
      <dl class="reference-counts">
        <div>
          <dt>Specimen entries</dt>
          <dd>{summary.mode_counts.specimen}</dd>
        </div>
        <div>
          <dt>Guide / source entries</dt>
          <dd>{summary.mode_counts.link}</dd>
        </div>
        <div>
          <dt>Explicit omissions</dt>
          <dd>{summary.mode_counts.omission}</dd>
        </div>
      </dl>
    </aside>

    <nav id="capability-index" class="reference-index" aria-label="Capability families">
      <ol>
        {referenceCoverage.families.map((family) => (
          <li>
            <a href={`#${family.id}`}>
              <span>{String(family.index).padStart(2, "0")}</span>
              {family.title}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="reference-families">
      {referenceCoverage.families.map((family) => (
        <section id={family.id} class="reference-family" aria-labelledby={`${family.id}-heading`}>
          <header class="reference-family-header">
            <p class="reference-family-index">{String(family.index).padStart(2, "0")}</p>
            <div>
              <h2 id={`${family.id}-heading`}>{family.title}</h2>
              <p>{family.summary}</p>
            </div>
          </header>
          <div class="reference-entry-grid">
            {family.entries.map((entry) => (
              <ReferenceEntry entry={entry} specimens={specimens} fragments={fragments} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <aside class="reference-method" aria-labelledby="reference-method-heading">
      <p class="proto-eyebrow">Source authority</p>
      <h2 id="reference-method-heading">One specimen registry, one checked coverage declaration.</h2>
      <p>
        Static evidence resolves to <code>tools.outputgen.PANELS</code>. The curated grouping lives beside
        <code>tools.reference_specimens.CATALOG</code>, and generation rejects unknown specimen IDs or a
        capability that is missing or counted twice.
      </p>
      <a class="reference-entry-link" href="https://github.com/kgruel/painted/blob/main/tools/reference_specimens.py">
        Inspect the declaration <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </div>
</Prototype>
