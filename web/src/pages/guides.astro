---
// guides.astro — the consumer ladder, level by level.
//
// The list is read from src/generated/docs/index.json, emitted by outputgen
// from the SAME painted._doc_pages.DOCS registry the terminal dispatches on —
// the site cannot list a guide `painted docs` doesn't have (or vice versa).
// `outputgen --check` gates the index like every fragment.
import Base from "../layouts/Base.astro";
import pages from "../generated/docs/index.json";

// Guides are the "Guide N — ..." entries, in ladder order; reference pages
// (primitives) keep their own doors.
const guides = pages
  .filter((p) => p.description.startsWith("Guide "))
  .map((p) => {
    const [level, rest] = p.description.split(" — ", 2);
    return { ...p, level, rest };
  });
---

<Base title="painted — guides">
  <main class="guides-root">
    <h1>Guides</h1>
    <p class="lede">
      Task-shaped, level by level — the same ladder the library is built
      around. Start at the rung that matches your problem; every rung above is
      additive, so climbing never rewrites what you have. Each guide also
      renders in your terminal: <code>painted docs &lt;name&gt;</code>.
    </p>
    <ol class="ladder">
      {
        guides.map((g) => (
          <li>
            <a href={`/docs/${g.name}`}>
              <span class="level">{g.level}</span>
              <span class="desc">{g.rest}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<style>
  .guides-root {
    max-width: 72ch;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  h1 {
    font-size: 1.6rem;
    margin: 0 0 1rem;
  }

  .lede {
    line-height: 1.6;
    color: var(--muted, #9a9a9a);
    margin-bottom: 2.5rem;
  }

  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ladder a {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line, #333);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
  }

  .ladder a:hover {
    border-color: var(--accent, #e8a33d);
  }

  .level {
    font-weight: bold;
    white-space: nowrap;
  }

  .desc {
    color: var(--muted, #9a9a9a);
  }
</style>
