---
// Landing page — static shell + the real Design hero island (the system-monitor
// Surface). Reference panels (real painted output via outputgen), guides, and
// search come in later slices.
//
// Laning: PaintedSurface is a COSMETIC brand recreation, not painted's renderer.
// Anywhere the site shows genuine product output, render it via the library.
import Base from "../layouts/Base.astro";
import PaintedSurface from "../components/PaintedSurface.jsx";
---

<Base title="painted — terminal rendering library">
  <main>
    <header>
      <div class="wordmark">painted</div>
      <p class="tagline">
        Python data → terminal pixels. The medium is the monospace cell grid:
        ANSI color, box-drawing characters, composable Blocks.
      </p>
    </header>

    <section class="hero-slot">
      <PaintedSurface client:visible initialView="Status" />
    </section>

    <footer>
      <span class="dim">cosmetic hero — recreation, not the renderer.</span> Real
      output renders through painted itself · reference panels + guides next.
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  .wordmark {
    font-size: var(--t-display);
    font-weight: var(--w-black);
    color: var(--cyan);
    line-height: var(--cell-lh-tight);
  }
  .tagline {
    font-size: var(--t-h3);
    color: var(--fg-2);
    max-width: 60ch;
    margin: var(--sp-3) 0 0;
  }
  /* Sized wrapper for the island — it fills its container (minHeight 520). */
  .hero-slot {
    height: min(80vh, 720px);
    display: flex;
  }
  footer {
    font-size: var(--t-small);
    color: var(--fg-dim);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-3);
  }
  .dim {
    color: var(--fg-dim);
  }
</style>
