---
import Prototype from "../layouts/Prototype.astro";
import PageHeader from "../components/PageHeader.astro";
import Specimen from "../components/Specimen.astro";
import Recording from "../components/Recording.astro";
import FeatureCard from "../components/FeatureCard.astro";
import CrossLink from "../components/CrossLink.astro";
import media from "../generated/media.json";

import monitorQ from "../generated/panels/monitor_q.html?raw";
import monitorDefault from "../generated/panels/monitor_default.html?raw";
import monitorVv from "../generated/panels/monitor_vv.html?raw";

const REPOSITORY = "https://github.com/kgruel/painted";
const continuumRecording = media.recordings.find((recording) => recording.id === "homepage/continuum");

if (
  !continuumRecording
  || continuumRecording.target_kind !== "homepage"
  || !continuumRecording.video
  || !continuumRecording.poster?.path
) {
  throw new Error("Missing declared homepage/continuum recording");
}
---

<Prototype
  title="painted — a semantic renderer for the terminal"
  description="Painted turns declared meaning into terminal cells, from a quiet print to a responsive CLI, live delivery, and an interactive Surface."
>
  <div class="proto-shell proto-page">
    <div class="proto-hero-grid">
      <PageHeader
        eyebrow="Semantic rendering for terminal cells"
        title="One declared meaning. Every terminal surface."
        summary="Painted turns semantic data into exact terminal cells — from a quiet line of output to a responsive CLI, live delivery, and an interactive Surface."
      >
        <div class="proto-hero-actions">
          <a class="proto-button" href="/learn/">Start with paint() <span aria-hidden="true">→</span></a>
          <a class="proto-install" href={REPOSITORY}><span aria-hidden="true">↗</span> View on GitHub</a>
          <code class="proto-install"><span aria-hidden="true">$</span> pip install painted</code>
        </div>
      </PageHeader>

      <div>
        <Specimen label="Host vitals" detail="a declared lens" source="monitor.py">
          <Fragment set:html={monitorDefault} />
        </Specimen>
        <aside class="proto-hero-note" aria-label="How to read the specimen">
          <p>Color, bar length, and density are choices declared by the lens — not a separate presentation layer.</p>
        </aside>
      </div>
    </div>

    <section class="proto-section" aria-labelledby="delivery-heading">
      <div class="proto-section-head">
        <div>
          <p class="proto-eyebrow">One rendering model</p>
          <h2 id="delivery-heading">Delivery reveals what a final frame cannot.</h2>
        </div>
        <p>Health checks resolve in place while their structure stays coherent from the first pending state to the final result.</p>
      </div>
      <Recording
        id={continuumRecording.id}
        title="Health checks, delivered over time"
        description={continuumRecording.accessibility_description}
        video={continuumRecording.video}
        poster={continuumRecording.poster.path}
        unavailableMessage="If video is unavailable, the progressive disclosure examples below remain useful static context."
      />
    </section>

    <section class="proto-section" aria-labelledby="continuum-heading">
      <div class="proto-section-head">
        <div>
          <p class="proto-eyebrow">Progressive disclosure</p>
          <h2 id="continuum-heading">Escalate the surface, not the meaning.</h2>
        </div>
        <p>One monitor lens receives the same data at three points in the disclosure ladder. These static examples remain useful independently of the recording. Wide grids scroll inside their own frame.</p>
      </div>
      <div class="proto-continuum">
        <div class="proto-continuum-item">
          <p class="proto-continuum-label"><strong>01</strong> quiet · worst first</p>
          <Specimen label="-q" detail="single line"><Fragment set:html={monitorQ} /></Specimen>
        </div>
        <div class="proto-continuum-item">
          <p class="proto-continuum-label"><strong>02</strong> default · declared lens</p>
          <Specimen label="default" detail="host vitals"><Fragment set:html={monitorDefault} /></Specimen>
        </div>
        <div class="proto-continuum-item">
          <p class="proto-continuum-label"><strong>03</strong> verbose · more evidence</p>
          <Specimen label="-vv" detail="per-metric status"><Fragment set:html={monitorVv} /></Specimen>
        </div>
      </div>
    </section>

    <section class="proto-section" aria-labelledby="capabilities-heading">
      <div class="proto-section-head">
        <div>
          <p class="proto-eyebrow">Use Painted when you need to</p>
          <h2 id="capabilities-heading">Make terminal behavior fit the job.</h2>
        </div>
        <p>Enter through the capability you need, then follow the matching path into the library.</p>
      </div>
      <div class="proto-capability-grid">
        <FeatureCard index="01" title="Show what matters" summary="Turn declared roles, marks, and relationships into cells that remain legible at a glance." href="/learn/paint/" linkLabel="Begin with paint()" />
        <FeatureCard index="02" title="Fit the available width" summary="Compose blocks, borders, tables, and lenses without losing the terminal’s exact cell contract." href="/guides/" linkLabel="Read responsive guides" />
        <FeatureCard index="03" title="Escalate delivery" summary="Carry one rendering model from a command invocation to live updates and an interactive Surface." href="/learn/altitude/" linkLabel="Follow the altitude path" />
      </div>
    </section>

    <section class="proto-section" aria-labelledby="entry-heading">
      <div class="proto-section-head">
        <div>
          <p class="proto-eyebrow">Choose an entry</p>
          <h2 id="entry-heading">Start from the question you have.</h2>
        </div>
        <p>Learn the model in sequence, solve a focused problem, browse runnable work, or look up a capability.</p>
      </div>
      <div class="proto-card-grid">
        <FeatureCard index="01" title="Learn" summary="Follow the altitude path from paint() through composition, lenses, CLI delivery, live output, and Surface." href="/learn/" linkLabel="Follow the path" />
        <FeatureCard index="02" title="Guides" summary="Enter through a specific concern: fidelity, responsive width, vocabularies, live delivery, prompts, or testing." href="/guides/" linkLabel="Browse guides" />
        <FeatureCard index="03" title="Demos" summary="See runnable primitives, patterns, applications, examples, and showcase pieces with their source and evidence." href="/demos/" linkLabel="Open demos" />
        <FeatureCard index="04" title="Reference" summary="Find capabilities, modules, and representative published specimens without treating the design system as the product." href="/reference/" linkLabel="Look up a capability" />
      </div>
    </section>

    <section class="proto-section" aria-label="Related destinations">
      <div class="proto-cross-links">
        <CrossLink eyebrow="Learn path" title="From value to Surface" summary="The progressive spine keeps the first useful stop clear while preserving the deeper implementation model." href="/learn/altitude/" linkLabel="View altitude path" />
        <CrossLink eyebrow="Methodology" title="Rendered by Painted" summary="Static output, semantic documents, recordings, and browser shell each have an explicit source of truth." href="/about/rendered-by-painted/" linkLabel="Read the methodology" />
        <CrossLink eyebrow="Compatibility" title="Existing walkthrough" summary="The original continuity page remains available as a deeper tour of the rendering model." href="/walkthrough/" linkLabel="Visit walkthrough" />
      </div>
    </section>
  </div>
</Prototype>
