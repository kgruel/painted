---
// Base.astro — the site shell. Pulls in the painted design tokens, sets the
// terminal-native defaults (monospace everywhere, ink canvas, ligatures off),
// and frames every page in the shared chrome: a sticky top nav + a footer.
//
// The chrome is plain HTML/CSS (not painted output) by design — it's the browser
// frame around the real renderer. Each nav destination carries the SAME hue as
// its door card on the landing page (walkthrough=cyan, reference=green,
// guides=orange), so the nav and the doors read as one color language.
//
// fonts.css MUST load first: it self-hosts the FULL JetBrains Mono (incl.
// box-drawing + block-elements). The Google Fonts CDN subset drops those glyphs,
// which broke painted's borders and wordmark — see fonts.css.
import "../styles/fonts.css";
import "../styles/colors_and_type.css";

interface Props {
  title?: string;
}
const { title = "painted" } = Astro.props;

const REPO = "https://github.com/kgruel/painted";

// Normalize the path (strip a trailing slash so "/reference/" matches "/reference").
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

// One hue per destination — the same hues the landing's door cards use.
const NAV = [
  { href: "/walkthrough", label: "walkthrough", hue: "var(--cyan)" },
  { href: "/reference", label: "reference", hue: "var(--green)" },
  { href: "/guides", label: "guides", hue: "var(--orange)", soon: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- JetBrains Mono is self-hosted (full glyph coverage) via styles/fonts.css.
         The Google Fonts CDN subset dropped box-drawing/block-elements, which broke
         painted's borders + wordmark, so the <link> form is intentionally gone. -->
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-inner">
        <a class="nav-mark" href="/" aria-current={path === "/" ? "page" : undefined}>
          <span class="nav-mark-name">painted</span><span class="nav-cursor" aria-hidden="true">▏</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {
            NAV.map((item) =>
              item.soon ? (
                <span class="nav-link is-soon" style={`--hue:${item.hue}`} aria-disabled="true">
                  {item.label}
                  <span class="nav-soon">soon</span>
                </span>
              ) : (
                <a
                  class="nav-link"
                  style={`--hue:${item.hue}`}
                  href={item.href}
                  aria-current={path === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              )
            )
          }
          <a class="nav-ext" href={REPO}>GitHub&nbsp;↗</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-foot">
      <div class="foot-inner">
        <span class="foot-brand">
          <span class="foot-name">painted</span> · a semantic renderer for the terminal
        </span>
        <span class="foot-links">
          <a href="/walkthrough">walkthrough</a> · <a href="/reference">reference</a> ·
          <a href={REPO}>source&nbsp;↗</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    /* In-page #anchor jumps (the walkthrough spine) must clear the sticky nav. */
    scroll-padding-top: 64px;
  }
  html,
  body {
    margin: 0;
    background: var(--ink);
  }
  body {
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    color: var(--fg);
    -webkit-font-smoothing: antialiased;
    font-size: var(--t-body);
    line-height: var(--cell-lh);
  }
  ::selection {
    background: var(--cyan);
    color: var(--ink);
  }
  a {
    color: var(--cyan);
  }
</style>

<style>
  /* --- Shared top nav --------------------------------------------------- */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--sp-2) var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  /* Wordmark — "painted" + a terminal cursor that pulses. */
  .nav-mark {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    font-weight: var(--w-bold);
    font-size: var(--t-body);
  }
  .nav-mark-name {
    color: var(--fg);
  }
  .nav-mark:hover .nav-mark-name {
    color: var(--cyan);
  }
  .nav-mark[aria-current="page"] .nav-mark-name {
    color: var(--cyan);
  }
  .nav-cursor {
    color: var(--cyan);
    margin-left: 1px;
    animation: nav-blink 1.1s steps(1) infinite;
  }
  @keyframes nav-blink {
    50% {
      opacity: 0;
    }
  }

  /* Links — lowercase, terminal-native. Each carries its destination hue. */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    font-size: var(--t-small);
  }
  .nav-link {
    position: relative;
    text-decoration: none;
    color: var(--fg-2);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .nav-link:hover {
    color: var(--hue);
  }
  .nav-link[aria-current="page"] {
    color: var(--hue);
    border-bottom-color: var(--hue);
  }
  .nav-link.is-soon {
    color: var(--fg-dim);
    cursor: not-allowed;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .nav-soon {
    font-size: var(--t-caption);
    color: var(--ink);
    background: var(--hue);
    opacity: 0.55;
    padding: 0 4px;
    border-radius: var(--radius);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .nav-ext {
    text-decoration: none;
    color: var(--fg-dim);
    font-size: var(--t-small);
  }
  .nav-ext:hover {
    color: var(--fg);
  }

  /* --- Shared footer ---------------------------------------------------- */
  .site-foot {
    border-top: 1px solid var(--line);
    margin-top: var(--sp-8);
  }
  .foot-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
    font-size: var(--t-small);
    color: var(--fg-dim);
  }
  .foot-name {
    color: var(--fg-2);
    font-weight: var(--w-bold);
  }
  .foot-links a {
    color: var(--fg-dim);
    text-decoration: none;
  }
  .foot-links a:hover {
    color: var(--cyan);
  }

  @media (max-width: 560px) {
    .nav-links {
      gap: var(--sp-3);
    }
    .nav-ext {
      display: none;
    }
    .foot-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
