---
interface Props {
  index?: string;
  title: string;
  summary: string;
  href: string;
  linkLabel?: string;
}

const { index, title, summary, href, linkLabel = "Explore" } = Astro.props;
---

<article class="proto-card">
  {index && <span class="proto-card-index" aria-hidden="true">{index}</span>}
  <h3>{title}</h3>
  <p>{summary}</p>
  <a class="proto-text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
</article>
